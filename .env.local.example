# Naam Jap — Firebase Configuration
# Copy this file to .env.local and fill in your values from:
# https://console.firebase.google.com → Project Settings → Your apps → SDK setup

# Firebase project config
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# For Push Notifications (FCM) — optional
# Get from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key

